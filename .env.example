# Copy to .env.local and fill in. .env.local is gitignored — never commit it.

# PostgreSQL (Neon). Project dashboard → Connection string.
DATABASE_URL=

# Restricted role for coder-facing queries (no SELECT on unblinded tables).
# Created alongside the first coder-facing route; until then leave empty.
DATABASE_URL_CODER=

# Auth.js session encryption secret. Generate once with: npx auth secret
AUTH_SECRET=

# Resend (sign-in code emails). resend.com → API Keys.
RESEND_API_KEY=
# Verified sender, e.g. codes@ltl-classroom-observations.org
EMAIL_FROM=

# 21st.dev component registry key. Install-time only, never used at runtime.
API_KEY_21ST=
