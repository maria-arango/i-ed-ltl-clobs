# Copy to .env.local and fill in. .env.local is gitignored — never commit it.

# PostgreSQL (Neon). Project dashboard → Connection string.
DATABASE_URL=

# Restricted role for coder- and enumerator-facing queries (no SELECT on
# unblinded tables, lesson IDs or narrative sources). Written into .env.local
# by `node scripts/setup-coder-role.mts`.
DATABASE_URL_CODER=

# Only for scripts/setup-coder-role.mts in CI or a fresh local database:
# the password to give the restricted role. Leave empty otherwise.
CODER_ROLE_PASSWORD=

# Auth.js session encryption secret. Generate once with: npx auth secret
AUTH_SECRET=

# Resend (email sign-in codes). OPTIONAL since ADR 0003: everyday sign-in is
# email + PIN; the email code at /signin/email is the admin fallback.
# Without it, development prints codes in the terminal.
RESEND_API_KEY=
# Verified sender, e.g. codes@ltl-classroom-observations.org
EMAIL_FROM=

# 21st.dev component registry key. Install-time only, never used at runtime.
API_KEY_21ST=
