{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "radix-nova",
  "rsc": true,
  "tsx": true,
  "tailwind": {
    "config": "",
    "css": "app/globals.css",
    "baseColor": "neutral",
    "cssVariables": true,
    "prefix": ""
  },
  "iconLibrary": "lucide",
  "rtl": false,
  "aliases": {
    "components": "@/components",
    "utils": "@/lib/utils",
    "ui": "@/components/ui",
    "lib": "@/lib",
    "hooks": "@/hooks"
  },
  "menuColor": "default",
  "menuAccent": "subtle",
  "registries": {
    "@beui": "https://beui.dev/r/{name}.json",
    "@21st": {
      "url": "https://21st.dev/r/{name}",
      "headers": {
        "Authorization": "Bearer ${API_KEY_21ST}"
      }
    },
    "@animate-ui": "https://animate-ui.com/r/{name}.json"
  }
}
